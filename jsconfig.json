{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"]
    },
    "moduleDetection": "force",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "vite.config.js", "tests/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
